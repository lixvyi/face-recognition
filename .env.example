# Copy to .env and fill in your key. NEVER commit .env.

LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.senseaudio.cn/v1
LLM_API_KEY=sk-your-senseaudio-key
LLM_MODEL=senseaudio-s2
LLM_WIRE_API=messages

LLM_MAX_TOKENS=16384
LLM_TIMEOUT_MS=600000
PORT=8173
FACE_MODEL_NAME=buffalo_s
IDENTITY_TIMEOUT_MS=180000
FACE_MATCH_THRESHOLD=0.45
PYTHON_BIN=python

# ═══════════════════════════════════════════════════════════
# 统一依赖安装（最后一次性执行，见下方 INSTALL 块）
# ═══════════════════════════════════════════════════════════

# ── 任务1：情绪 ViT-FER + WavLM SER + MDAT ──
EMOTION_FACE_MODEL=trpakov/vit-face-expression
SER_MODEL=jihedjabnoun/wavlm-base-emotion

# ── 任务2：多人音轨 pyannote 3.1 ──
PYANNOTE_HF_TOKEN=hf_your_token_here
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1

# ── 任务3：多人脸 MediaPipe + InsightFace 融合 ──
FACE_DETECTOR=both
# YOLO_FACE_MODEL=yolov8n-face.pt

# ── 任务4：VLM 物体 SSD grounding（前端 tfjs coco-ssd，无需 env）──

# Python 常驻 worker（默认开启）
# USE_PERSISTENT_WORKER=0

# ═══════════════════════════════════════════════════════════
# INSTALL — 复制到终端一次性安装（需 ffmpeg 在 PATH）
# ═══════════════════════════════════════════════════════════
# pip install torch torchaudio transformers pillow opencv-python insightface onnxruntime
# pip install pyannote.audio
# pip install ultralytics
# 然后在 HuggingFace 接受 pyannote 模型协议，填入 PYANNOTE_HF_TOKEN
