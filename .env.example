# Copy to .env and fill in your key. NEVER commit .env.

LLM_PROVIDER=openai-compatible
# SenseAudio VLM（本项目 TASK_GUIDE 默认，messages + Anthropic 风格 base64 图片）
LLM_BASE_URL=https://api.senseaudio.cn/v1
LLM_API_KEY=sk-your-senseaudio-key
LLM_MODEL=senseaudio-s2
LLM_WIRE_API=messages

# 备选：OpenAI 官方 → LLM_BASE_URL=https://api.openai.com/v1  LLM_WIRE_API=responses
# 备选：AIHubMix → LLM_BASE_URL=https://aihubmix.com/v1  LLM_WIRE_API=chat/completions

LLM_MAX_TOKENS=16384
LLM_TIMEOUT_MS=600000
PORT=8173
FACE_MODEL_NAME=buffalo_s
IDENTITY_TIMEOUT_MS=180000
FACE_MATCH_THRESHOLD=0.45
PYTHON_BIN=python
